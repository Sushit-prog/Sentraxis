# Application environment: dev | demo | prod
APP_ENV=dev

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# PostgreSQL connection (psycopg3 driver)
# Host port 5433 maps to the compose postgres (avoids clashing with a local Postgres)
DATABASE_URL=postgresql+psycopg://cyber:cyber@localhost:5433/cyber

# Redis connection
REDIS_URL=redis://localhost:6379/0

# --- Reserved for future milestones (leave commented until implemented) ---
# JWT_SECRET=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=

# --- LLM correlation (M3): free-tier keys; empty => rule-only correlation ---
# GROQ_API_KEY=         # https://console.groq.com
# OPENROUTER_API_KEY=   # https://openrouter.ai
# MISTRAL_API_KEY=      # https://console.mistral.ai
# LLM_PROVIDER_ORDER=groq,openrouter,mistral
# LLM_DAILY_BUDGET=300
# LLM_MIN_INTERVAL_MS=1500

# --- Auth (M3) ---
# JWT_SECRET=           # REQUIRED (strong value) when APP_ENV=prod
